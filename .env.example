# ─── STRIPE ──────────────────────────────────────────────────────────────────
# Required for Stripe checkout, subscriptions, and webhook verification.
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_MONITORING_PRICE_ID="price_..."

# ─── FIREBASE / FIRESTORE ─────────────────────────────────────────────────────
# Required for persistent storage (payments, monitoring subscriptions, analytics).
#
# On GCP / Cloud Run: set only FIREBASE_PROJECT_ID — ADC handles auth automatically.
# On Vercel: set all three — FIREBASE_CLIENT_EMAIL + FIREBASE_PRIVATE_KEY are required.
FIREBASE_PROJECT_ID="your-gcp-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxx@your-gcp-project-id.iam.gserviceaccount.com"
# IMPORTANT: paste the full private key including -----BEGIN/END----- lines.
# Vercel escapes newlines — the app handles \n → real newlines automatically.
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# ─── APPLICATION ──────────────────────────────────────────────────────────────
# The public URL of the deployed application.
# Used for Stripe success/cancel redirect URLs and webhook endpoint.
# Example: https://crawlsignal.vercel.app or https://crawlsignal.com
APP_URL="https://your-domain.vercel.app"

# ─── CRON AUTHENTICATION ──────────────────────────────────────────────────────
# Secret used to authenticate the Vercel Cron Job calling /api/cron/run-monitoring.
# Generate with: openssl rand -hex 32
# Must match the Authorization: Bearer <secret> header or x-cron-secret header.
CRON_SECRET="your-random-secret-here"

# ─── AI (OPTIONAL) ────────────────────────────────────────────────────────────
# Required only if AI Visibility feature is enabled.
GEMINI_API_KEY="your-gemini-api-key"
